# Cohabit Finance — Backend environment variables
# Copy this file to .env and fill in the values before running locally or on a server.
# On Azure App Service, set these as Application Settings (not via .env file).

# REQUIRED: Change this to a long random string in production.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# JWT config (defaults are fine)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=259200

# SQLite database path — overridden automatically on Azure via COHABIT_DATA_DIR
DATABASE_URL=sqlite:///data/app.db
