# Terraform state — contains secrets, never commit
*.tfstate
*.tfstate.backup
*.tfstate.lock.info

# Terraform working directory
.terraform/
.terraform.lock.hcl

# Real tfvars — contains secrets, never commit
# (terraform.tfvars.example is intentionally NOT ignored)
terraform.tfvars
*.auto.tfvars

# Crash logs
crash.log
crash.*.log

# Override files (local developer overrides)
override.tf
override.tf.json
*_override.tf
*_override.tf.json
